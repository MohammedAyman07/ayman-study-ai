# ==============================================================================
# AYMAN STUDY AI - ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================
# Copy this file to '.env' or '.env.local' for local development.
# For Vercel deployment, configure these keys in Project Settings > Environment Variables.
# NEVER commit your real '.env' file containing secrets to GitHub!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI PROVIDER API KEYS (Backend / Serverless)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Get at: https://aistudio.google.com/)
GEMINI_API_KEY="your_google_gemini_api_key_here"
# Optional comma-separated rotation keys for high-throughput failover:
# GEMINI_API_KEYS="key_1,key_2,key_3"

# Groq API Key (Ultra-fast Llama 3.3 inference - https://console.groq.com/)
GROQ_API_KEY="your_groq_api_key_here"
# Optional comma-separated rotation keys:
# GROQ_API_KEYS="gsk_1,gsk_2,gsk_3"

# OpenRouter API Key (Free tier fallback - https://openrouter.ai/)
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# Hugging Face API Token (Inference API - https://huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY="your_huggingface_api_key_here"

# ------------------------------------------------------------------------------
# 2. PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
# Razorpay Key ID (Public key for checkout popup)
VITE_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_ID="rzp_test_your_key_id"

# Razorpay Key Secret (Server-side secret used for HMAC verification - NEVER expose to client!)
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION (Google OAuth)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Web Client ID (Google Cloud Console > APIs & Credentials)
VITE_GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"

# ------------------------------------------------------------------------------
# 4. DATABASE & CREDIT PERSISTENCE (Optional - Hostinger MySQL, TiDB, PlanetScale, Supabase, Neon)
# ------------------------------------------------------------------------------
# If configured, user credits will be permanently saved in MySQL.
# If omitted, safe in-memory/localStorage session credit deduction will be used.
DATABASE_URL="mysql://username:password@host:3306/aymanstudyai"
# Or individual credentials:
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="your_db_username"
DB_PASS="your_db_password"
DB_NAME="aymanstudyai"
DB_SSL="false"
